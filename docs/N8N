      "parameters": {
        "jsCode": "// ============================================================\n// CODE NODE - RECOMENDAÇÃO PERSONALIZADA DE INVESTIMENTOS\n// ============================================================\n// Entrada:\n//   Clientes + investimentos vindos do Merge\n//\n// Cliente:\n//   nome\n//   email\n//   perfil\n//   saldo\n//\n// Investimento:\n//   perfil\n//   produto\n//   minimo\n//   rentabilidade\n//\n// Saída:\n//   1 item para cada cliente\n// ============================================================\n\nconst input = $input.all();\n\nconst clientes = [];\nconst investimentos = [];\n\n\n// ============================================================\n// 1. PERCORRE TODA A ESTRUTURA RECEBIDA DO MERGE\n// ============================================================\n\nfunction analisarEstrutura(valor) {\n\n  if (valor === null || valor === undefined) {\n    return;\n  }\n\n  // Se for array, analisa todos os elementos\n  if (Array.isArray(valor)) {\n\n    for (const item of valor) {\n      analisarEstrutura(item);\n    }\n\n    return;\n  }\n\n  // Ignora valores que não sejam objetos\n  if (typeof valor !== \"object\") {\n    return;\n  }\n\n\n  // ==========================================================\n  // IDENTIFICA CLIENTE\n  // ==========================================================\n\n  const possuiNome =\n    valor.nome !== undefined &&\n    valor.nome !== null &&\n    String(valor.nome).trim() !== \"\";\n\n  const possuiPerfil =\n    valor.perfil !== undefined &&\n    valor.perfil !== null &&\n    String(valor.perfil).trim() !== \"\";\n\n  const possuiSaldo =\n    valor.saldo !== undefined ||\n    valor.saldo_num !== undefined ||\n    valor.saldo_texto !== undefined;\n\n\n  if (\n    possuiNome &&\n    possuiPerfil &&\n    possuiSaldo\n  ) {\n\n    clientes.push(valor);\n  }\n\n\n  // ==========================================================\n  // IDENTIFICA INVESTIMENTO\n  // ==========================================================\n\n  const possuiProduto =\n    valor.produto !== undefined &&\n    valor.produto !== null &&\n    String(valor.produto).trim() !== \"\";\n\n  const possuiMinimo =\n    valor.minimo !== undefined &&\n    valor.minimo !== null;\n\n\n  if (\n    possuiPerfil &&\n    possuiProduto &&\n    possuiMinimo\n  ) {\n\n    investimentos.push(valor);\n  }\n\n\n  // ==========================================================\n  // PROCURA DENTRO DOS CAMPOS DO OBJETO\n  // ==========================================================\n\n  for (const chave of Object.keys(valor)) {\n\n    const conteudo = valor[chave];\n\n    if (\n      typeof conteudo === \"object\" &&\n      conteudo !== null\n    ) {\n\n      analisarEstrutura(conteudo);\n    }\n  }\n}\n\n\n// ============================================================\n// 2. ANALISA TODOS OS ITENS DO MERGE\n// ============================================================\n\nfor (const item of input) {\n  analisarEstrutura(item.json);\n}\n\n\n// ============================================================\n// 3. REMOVE CLIENTES DUPLICADOS\n// ============================================================\n\nconst clientesUnicos = Array.from(\n  new Map(\n    clientes.map((cliente, index) => [\n      cliente.email ||\n      cliente.nome ||\n      `cliente_${index}`,\n      cliente\n    ])\n  ).values()\n);\n\n\n// ============================================================\n// 4. REMOVE INVESTIMENTOS DUPLICADOS\n// ============================================================\n\nconst investimentosUnicos = [];\n\nconst investimentosIds = new Set();\n\nfor (const investimento of investimentos) {\n\n  const id = [\n    investimento.perfil,\n    investimento.produto,\n    investimento.minimo,\n    investimento.rentabilidade\n  ].join(\"|\");\n\n\n  if (!investimentosIds.has(id)) {\n\n    investimentosIds.add(id);\n\n    investimentosUnicos.push(investimento);\n  }\n}\n\n\n// ============================================================\n// 5. CONVERTE VALORES PARA NÚMERO\n// ============================================================\n\nfunction converterNumero(valor) {\n\n  if (\n    valor === undefined ||\n    valor === null ||\n    valor === \"\"\n  ) {\n\n    return 0;\n  }\n\n\n  if (typeof valor === \"number\") {\n    return valor;\n  }\n\n\n  let texto = String(valor)\n    .trim()\n    .replace(/R\\$/gi, \"\")\n    .replace(/\\s/g, \"\");\n\n\n  // Exemplo:\n  // 12.500,00\n  // ↓\n  // 12500.00\n\n  if (texto.includes(\",\")) {\n\n    texto = texto\n      .replace(/\\./g, \"\")\n      .replace(\",\", \".\");\n  }\n\n\n  texto = texto.replace(/[^\\d.-]/g, \"\");\n\n  return Number(texto) || 0;\n}\n\n\n// ============================================================\n// 6. FORMATA VALORES EM REAIS\n// ============================================================\n\nfunction formatarMoeda(valor) {\n\n  return Number(valor || 0).toLocaleString(\n    \"pt-BR\",\n    {\n      style: \"currency\",\n      currency: \"BRL\"\n    }\n  );\n}\n\n\n// ============================================================\n// 7. VERIFICA SE EXISTEM CLIENTES\n// ============================================================\n\nif (clientesUnicos.length === 0) {\n\n  return [\n    {\n      json: {\n        erro: true,\n\n        mensagem:\n          \"Nenhum cliente foi encontrado na entrada do Merge.\",\n\n        itens_recebidos:\n          input.length,\n\n        investimentos_encontrados:\n          investimentosUnicos.length,\n\n        dica:\n          \"O Code encontrou os investimentos, mas não encontrou clientes com nome, perfil e saldo.\"\n      }\n    }\n  ];\n}\n\n\n// ============================================================\n// 8. PROCESSA CADA CLIENTE\n// ============================================================\n\nconst resultado = [];\n\nfor (const cliente of clientesUnicos) {\n\n\n  // ==========================================================\n  // DADOS DO CLIENTE\n  // ==========================================================\n\n  const nome =\n    cliente.nome || \"Cliente\";\n\n\n  const email =\n    cliente.email || \"\";\n\n\n  const perfil =\n    String(cliente.perfil || \"Moderado\").trim();\n\n\n  // ==========================================================\n  // SALDO\n  // ==========================================================\n\n  let saldo = 0;\n\n\n  if (cliente.saldo_num !== undefined) {\n\n    saldo = converterNumero(\n      cliente.saldo_num\n    );\n\n  } else if (cliente.saldo !== undefined) {\n\n    saldo = converterNumero(\n      cliente.saldo\n    );\n\n  } else if (cliente.saldo_texto !== undefined) {\n\n    saldo = converterNumero(\n      cliente.saldo_texto\n    );\n  }\n\n\n  // ==========================================================\n  // 9. ENCONTRA INVESTIMENTOS DO PERFIL DO CLIENTE\n  // ==========================================================\n\n  const investimentosDoPerfil =\n    investimentosUnicos.filter(\n      investimento => {\n\n        const perfilInvestimento =\n          String(investimento.perfil || \"\")\n            .trim()\n            .toLowerCase();\n\n\n        return (\n          perfilInvestimento ===\n          perfil.toLowerCase()\n        );\n      }\n    );\n\n\n  // ==========================================================\n  // 10. SE NÃO EXISTIR INVESTIMENTO PARA O PERFIL\n  // ==========================================================\n\n  if (investimentosDoPerfil.length === 0) {\n\n    const mensagem = [\n      `Olá, ${nome}! 👋`,\n      ``,\n      `Analisamos seu perfil ${perfil} e, no momento, não encontramos um investimento cadastrado especificamente para esse perfil.`,\n      ``,\n      `Assim que novas opções estiverem disponíveis, poderemos analisar novamente para você.`\n    ].join(\"\\n\");\n\n\n    resultado.push({\n      json: {\n\n        nome,\n\n        email,\n\n        perfil,\n\n        saldo_num:\n          saldo,\n\n        saldo_texto:\n          formatarMoeda(saldo),\n\n        recomendacao:\n          null,\n\n        motivo:\n          \"perfil_sem_investimento\",\n\n        mensagem_escolhida:\n          mensagem\n\n      }\n    });\n\n\n    continue;\n  }\n\n\n  // ==========================================================\n  // 11. NORMALIZA OS VALORES MÍNIMOS\n  // ==========================================================\n\n  const opcoes =\n    investimentosDoPerfil.map(\n      investimento => ({\n\n        ...investimento,\n\n        minimo_num:\n          converterNumero(\n            investimento.minimo\n          )\n\n      })\n    );\n\n\n  // ==========================================================\n  // 12. FILTRA INVESTIMENTOS QUE CABEM NO SALDO\n  // ==========================================================\n\n  const disponiveis =\n    opcoes.filter(\n      investimento =>\n        saldo >= investimento.minimo_num\n    );\n\n\n  // ==========================================================\n  // 13. ESCOLHE O INVESTIMENTO\n  // ==========================================================\n\n  let recomendacao;\n\n\n  if (disponiveis.length > 0) {\n\n    // Se o cliente possui saldo suficiente,\n    // escolhe o investimento de maior valor mínimo\n    // que ainda cabe no saldo.\n\n    recomendacao =\n      [...disponiveis].sort(\n        (a, b) =>\n          b.minimo_num -\n          a.minimo_num\n      )[0];\n\n  } else {\n\n    // Se o cliente não possui saldo suficiente,\n    // escolhe o investimento de menor valor mínimo\n    // dentro do perfil.\n\n    recomendacao =\n      [...opcoes].sort(\n        (a, b) =>\n          a.minimo_num -\n          b.minimo_num\n      )[0];\n  }\n\n\n  // ==========================================================\n  // 14. DADOS DA RECOMENDAÇÃO\n  // ==========================================================\n\n  const produto =\n    recomendacao.produto ||\n    \"Investimento\";\n\n\n  const minimo =\n    recomendacao.minimo_num;\n\n\n  const rentabilidade =\n    recomendacao.rentabilidade ||\n    \"Não informada\";\n\n\n  // ==========================================================\n  // 15. VERIFICA SE O SALDO É SUFICIENTE\n  // ==========================================================\n\n  const saldoSuficiente =\n    saldo >= minimo;\n\n\n  const motivo =\n    saldoSuficiente\n      ? \"saldo_ok\"\n      : \"saldo_insuficiente\";\n\n\n  // ==========================================================\n  // 16. CRIA A MENSAGEM PERSONALIZADA\n  // ==========================================================\nlet mensagem;\n\nif (saldoSuficiente) {\n\n  mensagem =\n    `Olá, ${nome}! 👋 ` +\n    `Pelo seu perfil ${perfil}, uma opção que combina com você é o ${produto}. ` +\n    `💰 Valor mínimo: ${formatarMoeda(minimo)} ` +\n    `💵 Seu saldo atual: ${formatarMoeda(saldo)} ` +\n    `📈 Rentabilidade: ${rentabilidade} ` +\n    `Com seu saldo atual, você já possui o valor necessário para investir nessa opção.`;\n\n} else {\n\n  mensagem =\n    `Olá, ${nome}! 👋 ` +\n    `Pelo seu perfil ${perfil}, uma opção que pode ser interessante para você é o ${produto}. ` +\n    `💰 Valor mínimo: ${formatarMoeda(minimo)} ` +\n    `💵 Seu saldo atual: ${formatarMoeda(saldo)} ` +\n    `📈 Rentabilidade: ${rentabilidade} ` +\n    `No momento, seu saldo ainda não é suficiente para atingir o valor mínimo desse investimento. ` +\n    `Porém, essa pode ser uma opção para considerar quando você atingir o valor necessário.`;\n\n}\n\n  // ==========================================================\n  // 17. RETORNA O CLIENTE\n  // ==========================================================\n\n  resultado.push({\n    json: {\n\n      nome,\n\n      email,\n\n      perfil,\n\n      saldo_num:\n        saldo,\n\n      saldo_texto:\n        formatarMoeda(saldo),\n\n      recomendacao: {\n\n        perfil:\n          recomendacao.perfil,\n\n        produto,\n\n        minimo,\n\n        rentabilidade\n\n      },\n\n      motivo,\n\n      mensagem_escolhida:\n        mensagem\n\n    }\n  });\n\n}\n\n\n// ============================================================\n// 18. RETORNA TODOS OS CLIENTES\n// ============================================================\n\nreturn resultado;"
