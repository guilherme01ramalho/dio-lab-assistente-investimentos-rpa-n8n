        "jsCode": "// ============================================================\n// CODE NODE - PREPARAÇÃO DOS DADOS PARA IA\n// ============================================================\n// Objetivo:\n// Organizar os dados de cada cliente em um formato limpo\n// para serem enviados posteriormente para uma IA.\n//\n// Saída: 1 item por cliente\n// ============================================================\n\nconst items = $input.all();\n\nconst resultado = [];\n\n\n// ============================================================\n// 1. PROCESSA CADA CLIENTE\n// ============================================================\n\nfor (const item of items) {\n\n  const data = item.json;\n\n\n  // ==========================================================\n  // DADOS DO CLIENTE\n  // ==========================================================\n\n  const email =\n    data.email ||\n    data.email_to ||\n    \"\";\n\n  const nome =\n    data.nome ||\n    \"Cliente\";\n\n  const perfil =\n    data.perfil ||\n    \"Não informado\";\n\n\n  // ==========================================================\n  // SALDO\n  // ==========================================================\n\n  let saldo_num = 0;\n\n  if (data.saldo_num !== undefined) {\n\n    saldo_num = Number(data.saldo_num) || 0;\n\n  } else if (data.saldo !== undefined) {\n\n    saldo_num = converterNumero(data.saldo);\n\n  } else if (data.saldo_texto !== undefined) {\n\n    saldo_num = converterNumero(data.saldo_texto);\n\n  }\n\n\n  // ==========================================================\n  // SALDO FORMATADO\n  // ==========================================================\n\n  const saldo_texto =\n    formatarMoeda(saldo_num);\n\n\n  // ==========================================================\n  // RECOMENDAÇÃO\n  // ==========================================================\n\n  const recomendacaoOriginal =\n    data.recomendacao || {};\n\n\n  const recomendacao = {\n\n    perfil:\n      recomendacaoOriginal.perfil ||\n      perfil,\n\n    produto:\n      recomendacaoOriginal.produto ||\n      \"Não informado\",\n\n    minimo:\n      converterNumero(\n        recomendacaoOriginal.minimo\n      ),\n\n    rentabilidade:\n      recomendacaoOriginal.rentabilidade ||\n      \"Não informada\"\n\n  };\n\n\n  // ==========================================================\n  // MOTIVO\n  // ==========================================================\n\n  const motivo =\n    data.motivo ||\n    \"não informado\";\n\n\n  // ==========================================================\n  // MENSAGEM BASE\n  // ==========================================================\n  // Essa mensagem NÃO é a mensagem final.\n  //\n  // Ela serve como contexto para a IA entender:\n  // quem é o cliente\n  // qual é o perfil\n  // qual investimento foi recomendado\n  // qual é o saldo\n  // ==========================================================\n\n  let mensagem_base;\n\n  if (motivo === \"saldo_ok\") {\n\n    mensagem_base =\n      `${nome}, indo direto ao ponto: para o perfil ${perfil}, ` +\n      `o ${recomendacao.produto} é uma opção compatível. ` +\n      `(mínimo ${formatarMoeda(recomendacao.minimo)}). ` +\n      `Você tem ${saldo_texto}, então dá pra aplicar. ` +\n      `Rentabilidade: ${recomendacao.rentabilidade}.`;\n\n  } else if (motivo === \"saldo_insuficiente\") {\n\n    mensagem_base =\n      `${nome}, para o perfil ${perfil}, ` +\n      `o ${recomendacao.produto} pode ser uma opção interessante. ` +\n      `(mínimo ${formatarMoeda(recomendacao.minimo)}). ` +\n      `Você tem ${saldo_texto}, então ainda não atinge o valor mínimo. ` +\n      `Rentabilidade: ${recomendacao.rentabilidade}.`;\n\n  } else {\n\n    mensagem_base =\n      `${nome}, identificamos seu perfil como ${perfil}. ` +\n      `A recomendação atual é ${recomendacao.produto}. ` +\n      `Valor mínimo: ${formatarMoeda(recomendacao.minimo)}. ` +\n      `Rentabilidade: ${recomendacao.rentabilidade}.`;\n\n  }\n\n\n  // ==========================================================\n  // REGRAS PARA A IA\n  // ==========================================================\n\n  const copy_rules = {\n\n    idioma: \"pt-BR\",\n\n    tom: \"amigável e profissional\",\n\n    tamanho: \"curto (4-6 linhas)\",\n\n    evitar: [\n      \"promessas de ganho\",\n      \"garantias\",\n      \"linguagem agressiva\"\n    ]\n\n  };\n\n\n  // ==========================================================\n  // 2. MONTA O OBJETO FINAL\n  // ==========================================================\n\n  resultado.push({\n\n    json: {\n\n      email_to: email,\n\n      nome,\n\n      perfil,\n\n      saldo_texto,\n\n      saldo_num,\n\n      recomendacao,\n\n      motivo,\n\n      mensagem_base,\n\n      copy_rules\n\n    }\n\n  });\n\n}\n\n\n// ============================================================\n// 3. RETORNA TODOS OS CLIENTES\n// ============================================================\n\nreturn resultado;\n\n\n// ============================================================\n// FUNÇÃO - CONVERTER VALOR\n// ============================================================\n\nfunction converterNumero(valor) {\n\n  if (\n    valor === undefined ||\n    valor === null ||\n    valor === \"\"\n  ) {\n\n    return 0;\n  }\n\n\n  if (typeof valor === \"number\") {\n\n    return valor;\n  }\n\n\n  let texto =\n    String(valor)\n      .trim()\n      .replace(/R\\$/gi, \"\")\n      .replace(/\\s/g, \"\");\n\n\n  // Exemplo:\n  // 12.500,00\n  // ↓\n  // 12500.00\n\n  if (texto.includes(\",\")) {\n\n    texto =\n      texto\n        .replace(/\\./g, \"\")\n        .replace(\",\", \".\");\n\n  }\n\n\n  texto =\n    texto.replace(/[^\\d.-]/g, \"\");\n\n\n  return Number(texto) || 0;\n}\n\n\n// ============================================================\n// FUNÇÃO - FORMATAR MOEDA\n// ============================================================\n\nfunction formatarMoeda(valor) {\n\n  return Number(valor || 0).toLocaleString(\n    \"pt-BR\",\n    {\n      style: \"currency\",\n      currency: \"BRL\"\n    }\n  );\n\n}"
