        "jsCode": "// Pega o CSV como texto vindo do HTTP Request\nconst csvRaw = $json.data ?? $json.body ?? $json;\n\nconst text = typeof csvRaw === \"string\"\n  ? csvRaw\n  : JSON.stringify(csvRaw);\n\n// Divide o CSV em linhas\nconst lines = text\n  .split(/\\r?\\n/)\n  .map(line => line.trim())\n  .filter(Boolean);\n\n// Verifica se existe conteúdo\nif (lines.length === 0) {\n  return [{\n    json: {\n      investimentos: []\n    }\n  }];\n}\n\n// Extrai os cabeçalhos\nconst headers = lines[0]\n  .split(\",\")\n  .map(header => header.trim());\n\n// Converte as linhas em objetos\nconst investimentos = lines.slice(1).map(line => {\n  const cols = line\n    .split(\",\")\n    .map(col => col.trim());\n\n  const obj = {};\n\n  headers.forEach((header, index) => {\n    obj[header] = cols[index] ?? \"\";\n  });\n\n  // Normaliza o campo \"minimo\" para número\n  if (obj.minimo !== undefined) {\n    const valor = String(obj.minimo)\n      .replace(/\\./g, \"\")\n      .replace(\",\", \".\")\n      .replace(/[^\\d.-]/g, \"\");\n\n    obj.minimo = Number(valor) || 0;\n  }\n\n  return obj;\n});\n\n// Retorna os investimentos para o próximo node\nreturn [\n  {\n    json: {\n      investimentos\n    }\n  }\n];"
