        "jsCode": "// ============================================================\n// AGRUPAR TODOS OS CLIENTES EM UM ÚNICO ITEM\n// ============================================================\n\nconst items = $input.all();\n\nconst clientes = [];\n\nfor (let i = 0; i < items.length; i++) {\n\n  const data = items[i].json;\n\n  clientes.push({\n    id_cliente: i + 1,\n\n    email_to: data.email_to || data.email || \"\",\n\n    nome: data.nome || \"Cliente\",\n\n    perfil: data.perfil || \"\",\n\n    saldo_texto: data.saldo_texto || \"\",\n\n    saldo_num: Number(data.saldo_num) || 0,\n\n    recomendacao: {\n      perfil:\n        data.recomendacao?.perfil ||\n        data.perfil ||\n        \"\",\n\n      produto:\n        data.recomendacao?.produto ||\n        \"\",\n\n      minimo:\n        Number(data.recomendacao?.minimo) || 0,\n\n      rentabilidade:\n        data.recomendacao?.rentabilidade ||\n        \"\"\n    },\n\n    motivo:\n      data.motivo || \"\",\n\n    mensagem_base:\n      data.mensagem_base || \"\",\n\n    copy_rules:\n      data.copy_rules || {\n        idioma: \"pt-BR\",\n        tom: \"amigável e profissional\",\n        tamanho: \"curto (4-6 linhas)\",\n        evitar: [\n          \"promessas de ganho\",\n          \"garantias\",\n          \"linguagem agressiva\"\n        ]\n      }\n  });\n}\n\n\n// ============================================================\n// RETORNA UM ÚNICO ITEM\n// ============================================================\n\nreturn [\n  {\n    json: {\n      quantidade_clientes: clientes.length,\n      clientes: clientes\n    }\n  }\n];"
