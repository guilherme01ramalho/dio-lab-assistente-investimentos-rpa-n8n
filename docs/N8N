      "parameters": {
        "jsCode": "\nconst dados = $json;\n\n// 1. Identifica a resposta gerada pelo node anterior\nconst resposta =\n  dados.output ??\n  dados.text ??\n  dados.response ??\n  dados.answer ??\n  dados.message ??\n  dados.content ??\n  '';\n\nlet mensagem = typeof resposta === 'string'\n  ? resposta\n  : JSON.stringify(resposta);\n\nmensagem = mensagem.trim();\n\n// 2. Remove blocos Markdown, caso existam\nmensagem = mensagem\n  .replace(/^```(?:html|text|markdown)?\\s*/i, '')\n  .replace(/\\s*```$/i, '')\n  .trim();\n\n// 3. Extrai o assunto, se a resposta já contiver \"Assunto:\"\nconst correspondencia = mensagem.match(/^Assunto:\\s*(.+)$/im);\n\nconst assunto = correspondencia\n  ? correspondencia[1].trim()\n  : 'Retorno da sua solicitação';\n\nif (correspondencia) {\n  mensagem = mensagem\n    .replace(/^Assunto:\\s*.+\\n?/im, '')\n    .trim();\n}\n\n// 4. Adiciona saudação se não houver uma\nif (!/^(olá|ola|bom dia|boa tarde|boa noite|prezado|prezada)\\b/i.test(mensagem)) {\n  mensagem = `Olá!<br><br>${mensagem}`;\n}\n\n// 5. Converte quebras de linha em HTML\nmensagem = mensagem.replace(/\\r\\n|\\r|\\n/g, '<br>');\n\n// 6. Adiciona despedida se não houver uma\nif (!/(atenciosamente|cordialmente|abraços|abraço|fico à disposição|fico a disposição)/i.test(mensagem)) {\n  mensagem += '<br><br>Atenciosamente,<br>Equipe de Atendimento';\n}\n\n// 7. Monta o HTML do e-mail\nconst mensagemHtml = `\n<div style=\"font-family: Arial, Helvetica, sans-serif; font-size: 14px; color: #333333; line-height: 1.6;\">\n  ${mensagem}\n</div>\n`.trim();\n\n// 8. Retorna os campos para o Gmail\nreturn {\n  json: {\n    to: dados.email_to ?? dados.email ?? '',\n    subject: assunto,\n    message: mensagemHtml\n  }\n};\n"
